{
  "compilerOptions": {
    "lib": ["dom"],
    "target": "es2022",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["**/*.js"],
  "exclude": [
    "node_modules",
    "**/*.test.js",
    "test/**",
    "eslint.config.js",
    "coverage"
  ]
}
